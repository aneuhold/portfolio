{
  // A solution file: it holds no sources of its own, it only names the projects the
  // workspace is made of. TypeScript walks these references to answer "find all
  // references" and "rename" from any project into any other, which is what lets a
  // symbol in `packages/shared` list its usages in both apps without them being open.
  "files": [],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./scripts" },
    { "path": "./svelte" },
    { "path": "./react" }
  ]
}
